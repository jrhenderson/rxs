# Copy this file to .env and fill in VENUE for local development.
# In production (GitHub Pages), these same keys are set as GitHub Actions
# repository variables (Settings -> Secrets and variables -> Actions ->
# Variables) and injected by the deploy workflow instead of a committed .env.
# See specs/001-rugby-scoreboard/spec.md for the full description of each key.

# Required. Exact venue name as returned by the API, e.g. "Nagle Park Field 2".
# Matched case-insensitively/trimmed. Find venue names by checking a live
# response from https://rugby-au-cms.graphcdn.app/ or the xplorer.rugby site.
VENUE=Nagle Park Field 2

# Season passed to the API.
SEASON=2026

# SJRU association entity id / type (from comp=All&team=All on xplorer.rugby/sjru).
ENTITY_ID=30895
ENTITY_TYPE=association

# GraphQL endpoint backing xplorer.rugby.
GRAPHQL_ENDPOINT=https://rugby-au-cms.graphcdn.app/

# Data poll interval, in seconds.
REFRESH_INTERVAL_SECONDS=60

# How many minutes before kickoff a match becomes the displayed "current" match.
PRE_MATCH_WINDOW_MINUTES=30

# How many minutes after kickoff a finished match stays displayed as "current"
# before falling back to the next upcoming fixture at the venue.
POST_MATCH_WINDOW_MINUTES=90

# Full hard page reload interval, in hours (kiosk long-run stability).
PAGE_RELOAD_HOURS=6

# IANA timezone used to display kickoff times.
TIMEZONE=Australia/Sydney
